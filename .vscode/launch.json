{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mongo js",
            "program": "${workspaceFolder}/part3/notes-backend/mongo.js",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "Backend: Part 2 Phonebook (Dev Watch)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/part2/phonebook-backend/index.js",
            "runtimeArgs": [
                "--watch"
            ],
            "cwd": "${workspaceFolder}/part2/phonebook-backend",
            "restart": true,
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "BE: Part 3 Notes (Dev Watch)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/part3/notes-backend/index.js",
            "runtimeArgs": [
                "--watch"
            ],
            "cwd": "${workspaceFolder}/part3/notes-backend",
            "restart": true,
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "BE: Part 4 Notes (Dev Watch)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/part4/notes-backend/index.js",
            "runtimeArgs": [
                "--watch"
            ],
            "cwd": "${workspaceFolder}/part4/notes-backend",
            "restart": true,
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
